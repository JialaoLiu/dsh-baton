{
  "name": "dsh-baton-mcp",
  "version": "0.6.2",
  "mcpName": "io.github.JialaoLiu/dsh-baton",
  "description": "Pass the baton from Claude Code, Codex or any MCP client to a local DeepSeek Harness: an MCP server that hands off tasks, continues a specific session, shows the run live in Harness and hands the result back when it is done.",
  "type": "module",
  "bin": {
    "dsh-baton": "src/cli.mjs",
    "dsh-baton-mcp": "src/bin.mjs"
  },
  "files": [
    "src",
    "host/lib",
    "host/package.json",
    "host/cordis.patch.yml",
    "host/README.md",
    "host/LICENSE",
    "patches",
    "README.md",
    "README.zh-CN.md",
    "WINDOWS.md",
    "LICENSE",
    "server.json"
  ],
  "engines": {
    "node": ">=22.15"
  },
  "keywords": [
    "mcp",
    "deepseek",
    "deepseek-harness",
    "claude-code",
    "codex",
    "multi-agent",
    "orchestration"
  ],
  "license": "MIT",
  "scripts": {
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:live": "node tests/live.mjs",
    "prepublishOnly": "node scripts/version.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/JialaoLiu/dsh-baton.git"
  },
  "homepage": "https://github.com/JialaoLiu/dsh-baton#readme",
  "bugs": {
    "url": "https://github.com/JialaoLiu/dsh-baton/issues"
  }
}
